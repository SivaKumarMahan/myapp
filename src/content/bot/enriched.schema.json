{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sivakumarmahan.github.io/myapp/bot/enriched.schema.json",
  "title": "Study Bot overlay file",
  "description": "Hand-written enrichment for one interview topic. Each entry adds to (or overrides) what the bot derives from the existing question with the same id: longAnswer, topic and level come from the question itself and are not repeated here.",
  "type": "object",
  "required": ["topic", "questions"],
  "additionalProperties": false,
  "definitions": {
    "keyPoint": {
      "type": "object",
      "required": ["point", "keywords", "weight"],
      "additionalProperties": false,
      "properties": {
        "point": {
          "type": "string",
          "minLength": 5
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    }
  },
  "properties": {
    "topic": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "enum": ["basic", "intermediate", "senior"]
          },
          "shortAnswer": {
            "type": "string",
            "minLength": 40
          },
          "longAnswer": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["heading", "text"],
              "additionalProperties": false,
              "properties": {
                "heading": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "keyPoints": {
            "type": "array",
            "minItems": 4,
            "maxItems": 8,
            "items": {
              "$ref": "#/definitions/keyPoint"
            }
          },
          "commonMistakes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["mistake", "triggers", "correction"],
              "additionalProperties": false,
              "properties": {
                "mistake": {
                  "type": "string"
                },
                "triggers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "correction": {
                  "type": "string"
                }
              }
            }
          },
          "followUps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["question", "shortAnswer", "keyPoints"],
              "additionalProperties": false,
              "properties": {
                "question": {
                  "type": "string"
                },
                "shortAnswer": {
                  "type": "string"
                },
                "keyPoints": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 5,
                  "items": {
                    "$ref": "#/definitions/keyPoint"
                  }
                }
              }
            }
          },
          "hints": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          },
          "analogy": {
            "type": "string"
          },
          "simpleExplanation": {
            "type": "string"
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scenarioVariant": {
            "type": "object",
            "required": ["question"],
            "additionalProperties": false,
            "properties": {
              "question": {
                "type": "string"
              },
              "shortAnswer": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
