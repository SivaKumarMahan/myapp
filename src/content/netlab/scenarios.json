            "sourcePort": 51000,
            "destinationIp": "10.0.1.4",
            "destinationPort": 80
          },
          "expect": "Deny"
        }
      ],
      "solution": {
        "subnetNsg": [
          {
            "name": "allow-https",
            "priority": 100,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "TCP",
            "source": "Internet",
            "sourcePorts": "*",
            "destination": "*",
