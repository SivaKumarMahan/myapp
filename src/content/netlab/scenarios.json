    {
      "id": "outbound",
      "title": "Lock down outbound traffic",
      "exam": "AZ-104",
      "brief": "Compliance says the VMs may only reach the Internet on **HTTPS (443)**. They must still reach each other. By default NSGs allow all outbound Internet traffic - change that.",
      "vnet": ["10.0.0.0/16"],
      "subnetNsg": {
        "name": "nsg-snet-app",
        "attached": true,
        "rules": []
      },
      "nicNsg": {
        "name": "nsg-vm-app",
        "attached": false,
        "rules": []
      },
      "packets": [
        {
          "label": "Calling an HTTPS API",
          "packet": {
            "direction": "Outbound",
            "protocol": "TCP",
            "sourceIp": "10.0.1.4",
            "sourcePort": 50000,
            "destinationIp": "20.50.2.10",
            "destinationPort": 443
          },
          "expect": "Allow"
        },
        {
          "label": "Downloading over HTTP",
          "packet": {
            "direction": "Outbound",
            "protocol": "TCP",
            "sourceIp": "10.0.1.4",
            "sourcePort": 50000,
            "destinationIp": "20.50.2.10",
            "destinationPort": 80
          },
          "expect": "Deny"
        },
        {
          "label": "DNS to a public resolver",
          "packet": {
            "direction": "Outbound",
            "protocol": "UDP",
            "sourceIp": "10.0.1.4",
            "sourcePort": 50000,
            "destinationIp": "8.8.8.8",
            "destinationPort": 53
          },
          "expect": "Deny"
        },
        {
          "label": "Talking to the database VM",
          "packet": {
            "direction": "Outbound",
            "protocol": "TCP",
            "sourceIp": "10.0.1.4",
            "sourcePort": 50000,
            "destinationIp": "10.0.3.4",
            "destinationPort": 1433
          },
          "expect": "Allow"
        }
      ],
      "solution": {
        "subnetNsg": [
