            "destination": "*",
            "destinationPorts": "80-443"
          }
        ]
      },
      "packets": [
        {
          "label": "HTTPS from a customer",
          "packet": {
            "direction": "Inbound",
            "protocol": "TCP",
            "sourceIp": "198.51.100.7",
            "sourcePort": 51000,
            "destinationIp": "10.0.1.4",
            "destinationPort": 443
          },
          "expect": "Allow"
        },
        {
          "label": "HTTP from a customer",
          "packet": {
            "direction": "Inbound",
            "protocol": "TCP",
            "sourceIp": "198.51.100.7",
            "sourcePort": 51000,
            "destinationIp": "10.0.1.4",
            "destinationPort": 80
          },
          "expect": "Deny"
