      ],
      "solution": {
        "subnetNsg": [
          {
            "name": "allow-https",
            "priority": 100,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "TCP",
            "source": "Internet",
            "sourcePorts": "*",
            "destination": "*",
            "destinationPorts": "443"
          }
        ],
        "nicNsg": [
          {
            "name": "allow-https",
            "priority": 100,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "TCP",
            "source": "Internet",
            "sourcePorts": "*",
            "destination": "*",
            "destinationPorts": "443"
          },
          {
            "name": "deny-web-ports",
            "priority": 110,
