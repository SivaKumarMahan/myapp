    {
      "id": "priority-trap",
      "title": "The priority trap",
      "exam": "AZ-104",
      "brief": "Someone added a \"deny everything\" rule to be safe. Now HTTPS fails, the VMs cannot talk to each other and the load balancer marks every VM unhealthy. Fix the rules: HTTPS from the Internet, VNet traffic and load-balancer probes must work; HTTP must not.",
      "vnet": ["10.0.0.0/16"],
      "subnetNsg": {
        "name": "nsg-snet-web",
        "attached": true,
        "rules": [
          {
            "name": "deny-all",
            "priority": 100,
            "direction": "Inbound",
            "access": "Deny",
            "protocol": "Any",
            "source": "Any",
            "sourcePorts": "*",
            "destination": "*",
            "destinationPorts": "*"
          },
          {
            "name": "allow-https",
            "priority": 200,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "TCP",
            "source": "Internet",
            "sourcePorts": "*",
            "destination": "*",
            "destinationPorts": "443"
          }
        ]
      },
      "nicNsg": {
        "name": "nsg-vm-web",
        "attached": false,
        "rules": []
      },
      "packets": [
        {
