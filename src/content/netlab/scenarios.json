{
  "$comment": "Networking lab scenarios. cidr: requirements are JMESPath over {vnet, subnets[{name, cidr, prefix, usable}], errors, warnings}. nsg: every packet must get its expected verdict. peering: answers are checked against the reachability engine in the tests.",
  "cidr": [
    {
      "id": "hub-vnet",
      "title": "Plan a hub VNet",
      "exam": "AZ-104",
      "brief": "You are building the hub of a hub-and-spoke network in **10.0.0.0/22**. It needs a VPN gateway, Azure Firewall, Azure Bastion and a management subnet with room for at least 50 VMs. Give each service the subnet it needs - right name, big enough - with no overlaps.",
      "start": {
        "vnet": "10.0.0.0/22",
        "subnets": [
          {
            "name": "GatewaySubnet",
            "cidr": "10.0.0.0/28"
          }
        ]
      },
      "solution": {
        "vnet": "10.0.0.0/22",
        "subnets": [
          {
            "name": "GatewaySubnet",
            "cidr": "10.0.0.0/27"
          },
          {
            "name": "AzureFirewallSubnet",
            "cidr": "10.0.1.0/26"
          },
          {
            "name": "AzureBastionSubnet",
            "cidr": "10.0.1.64/26"
          },
          {
            "name": "snet-management",
            "cidr": "10.0.2.0/25"
          }
        ]
      },
      "requirements": [
        {
          "description": "No errors or warnings",
          "query": "errors == `0` && warnings == `0`"
        },
        {
          "description": "GatewaySubnet is there",
          "query": "length(subnets[?name=='GatewaySubnet']) == `1`"
        },
        {
          "description": "AzureFirewallSubnet is there",
          "query": "length(subnets[?name=='AzureFirewallSubnet']) == `1`"
        },
        {
          "description": "AzureBastionSubnet is there",
          "query": "length(subnets[?name=='AzureBastionSubnet']) == `1`"
        },
        {
          "description": "A management subnet has at least 50 usable addresses",
          "query": "length(subnets[?contains(name, 'management') && usable >= `50`]) >= `1`"
        }
      ]
    },
    {
      "id": "fix-plan",
      "title": "Fix a broken subnet plan",
      "exam": "AZ-104",
      "brief": "A colleague's plan for **10.20.0.0/16** will not deploy. Find and fix every problem, keeping the web, app and data subnets and adding Azure Bastion.",
      "start": {
        "vnet": "10.20.0.0/16",
        "subnets": [
          {
            "name": "snet-web",
            "cidr": "10.20.1.0/24"
          },
          {
            "name": "snet-app",
            "cidr": "10.20.1.128/25"
          },
          {
            "name": "snet-data",
            "cidr": "10.21.0.0/24"
          },
          {
            "name": "BastionSubnet",
            "cidr": "10.20.10.0/27"
          },
          {
            "name": "snet-tiny",
            "cidr": "10.20.20.0/30"
          }
        ]
      },
      "solution": {
        "vnet": "10.20.0.0/16",
        "subnets": [
          {
            "name": "snet-web",
            "cidr": "10.20.1.0/24"
          },
          {
            "name": "snet-app",
            "cidr": "10.20.2.0/24"
          },
          {
            "name": "snet-data",
            "cidr": "10.20.3.0/24"
          },
          {
            "name": "AzureBastionSubnet",
            "cidr": "10.20.10.0/26"
          }
        ]
      },
      "requirements": [
        {
          "description": "No errors or warnings",
          "query": "errors == `0` && warnings == `0`"
        },
        {
          "description": "snet-web, snet-app and snet-data are still there",
          "query": "length(subnets[?name=='snet-web' || name=='snet-app' || name=='snet-data']) == `3`"
        },
        {
          "description": "Azure Bastion has its subnet",
          "query": "length(subnets[?name=='AzureBastionSubnet']) == `1`"
        }
      ]
    },
    {
      "id": "size-for-aks",
      "title": "Size a subnet for AKS",
      "exam": "AZ-104",
      "brief": "An AKS cluster using Azure CNI needs **500** addresses in its subnet today, and the VNet is **10.1.0.0/20**. Add `snet-aks` big enough, and `snet-ingress` with at least 20 usable addresses. Remember Azure keeps 5 addresses in every subnet.",
      "start": {
        "vnet": "10.1.0.0/20",
        "subnets": [
          {
            "name": "snet-aks",
            "cidr": "10.1.0.0/24"
          }
        ]
      },
      "solution": {
        "vnet": "10.1.0.0/20",
        "subnets": [
          {
            "name": "snet-aks",
            "cidr": "10.1.0.0/23"
          },
          {
            "name": "snet-ingress",
            "cidr": "10.1.2.0/27"
          }
        ]
      },
      "requirements": [
        {
          "description": "No errors",
          "query": "errors == `0`"
        },
        {
          "description": "snet-aks has at least 500 usable addresses",
          "query": "length(subnets[?name=='snet-aks' && usable >= `500`]) == `1`"
        },
        {
          "description": "snet-ingress has at least 20 usable addresses",
          "query": "length(subnets[?name=='snet-ingress' && usable >= `20`]) == `1`"
        }
      ]
    },
    {
      "id": "smallest-vnet",
      "title": "The smallest VNet that fits",
      "exam": "AZ-104",
      "brief": "Plan four subnets, each with at least **25** usable addresses, in the **smallest** VNet address space that holds them all. Start from 192.168.10.0.",
      "start": {
        "vnet": "192.168.10.0/24",
        "subnets": [
          {
            "name": "snet-a",
            "cidr": "192.168.10.0/26"
          }
        ]
      },
      "solution": {
        "vnet": "192.168.10.0/25",
        "subnets": [
          {
            "name": "snet-a",
            "cidr": "192.168.10.0/27"
          },
          {
            "name": "snet-b",
            "cidr": "192.168.10.32/27"
          },
          {
            "name": "snet-c",
            "cidr": "192.168.10.64/27"
          },
          {
            "name": "snet-d",
            "cidr": "192.168.10.96/27"
          }
        ]
      },
      "requirements": [
        {
          "description": "No errors",
          "query": "errors == `0`"
        },
        {
          "description": "Four subnets, each with at least 25 usable addresses",
          "query": "length(subnets[?usable >= `25`]) == `4` && length(subnets) == `4`"
        },
        {
          "description": "The VNet is as small as it can be (a /25)",
          "query": "vnet.prefix == `25`"
        }
      ]
    }
  ],
  "nsg": [
    {
      "id": "open-web",
      "title": "Open a web server - safely",
      "exam": "AZ-104",
      "brief": "The web VM (10.0.1.4) must accept **HTTPS from anywhere** and **SSH only from the office (203.0.113.10)**. Nothing else from the Internet. Add the rules to the subnet NSG.",
      "vnet": ["10.0.0.0/16"],
      "subnetNsg": {
        "name": "nsg-snet-web",
        "attached": true,
        "rules": []
      },
      "nicNsg": {
        "name": "nsg-vm-web",
        "attached": false,
        "rules": []
      },
      "packets": [
        {
          "label": "HTTPS from a customer",
          "packet": {
            "direction": "Inbound",
            "protocol": "TCP",
            "sourceIp": "198.51.100.7",
            "sourcePort": 51000,
            "destinationIp": "10.0.1.4",
            "destinationPort": 443
          },
          "expect": "Allow"
        },
        {
          "label": "HTTP from a customer",
          "packet": {
            "direction": "Inbound",
            "protocol": "TCP",
            "sourceIp": "198.51.100.7",
            "sourcePort": 51000,
            "destinationIp": "10.0.1.4",
            "destinationPort": 80
          },
          "expect": "Deny"
        },
        {
          "label": "SSH from the office",
          "packet": {
            "direction": "Inbound",
            "protocol": "TCP",
            "sourceIp": "203.0.113.10",
            "sourcePort": 52000,
            "destinationIp": "10.0.1.4",
            "destinationPort": 22
          },
          "expect": "Allow"
        },
        {
          "label": "SSH from anywhere else",
          "packet": {
            "direction": "Inbound",
            "protocol": "TCP",
            "sourceIp": "198.51.100.7",
            "sourcePort": 52000,
            "destinationIp": "10.0.1.4",
            "destinationPort": 22
          },
          "expect": "Deny"
        }
      ],
      "solution": {
        "subnetNsg": [
          {
            "name": "allow-https",
            "priority": 100,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "TCP",
            "source": "Internet",
            "sourcePorts": "*",
            "destination": "*",
            "destinationPorts": "443"
          },
          {
            "name": "allow-ssh-office",
            "priority": 110,
            "direction": "Inbound",
            "access": "Allow",
            "protocol": "TCP",
            "source": "203.0.113.10",
            "sourcePorts": "*",
            "destination": "*",
            "destinationPorts": "22"
          }
        ],
        "nicNsg": []
      }
    },
    {
