          "key": "waf",
          "value": true,
          "text": "A WAF on the public entry"
        },
        {
          "kind": "regions",
          "min": 2,
          "text": "The app and data in at least two regions"
        },
        {
          "kind": "noFindings",
          "rules": ["geo-data"],
          "text": "A copy of the data in every region that serves traffic"
        },
        {
          "kind": "noFindings",
          "rules": [
            "waf",
            "data-public",
            "private-endpoint",
            "secrets",
            "monitoring",
